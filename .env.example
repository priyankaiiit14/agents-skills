# Copy this file to .env and fill in your values.
# .env is gitignored and loaded automatically by scripts/test.sh.

# Required for Layer B behavioral evals (scripts/test.sh --evals).
OPENAI_API_KEY=sk-...
RUN_EVALS=1

# Optional: override the models used by the eval harness.
# EVAL_EXECUTOR_MODEL=gpt-4o
# EVAL_JUDGE_MODEL=gpt-4o-mini
